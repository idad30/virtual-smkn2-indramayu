rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validMajor(major) {
      return major in ['NKPI', 'APHPI', 'TKJ', 'RPL', 'TAB', 'KULINER', 'APAPL', 'TP'];
    }

    function validClass(major, number) {
      return number is int &&
        ((major == 'NKPI' && number >= 1 && number <= 2) ||
         (major == 'APHPI' && number >= 1 && number <= 2) ||
         (major == 'TKJ' && number >= 1 && number <= 3) ||
         (major == 'RPL' && number >= 1 && number <= 2) ||
         (major == 'TAB' && number >= 1 && number <= 3) ||
         (major == 'KULINER' && number >= 1 && number <= 3) ||
         (major == 'APAPL' && number == 1) ||
         (major == 'TP' && number >= 1 && number <= 2));
    }

    // Pengaturan maintenance dapat dibaca publik agar semua halaman tahu statusnya.
    // Hanya UID admin yang boleh mengubahnya.
    match /settings/maintenance {
      allow get: if true;
      allow list: if false;
      allow create, update: if signedIn() && request.auth.uid == '7mQtL5NIu0RtN5UOWy8TLiWL5zP2'
        && request.resource.data.keys().hasOnly(['enabled','message','expectedEnd','updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 240
        && request.resource.data.expectedEnd is string
        && request.resource.data.expectedEnd.size() <= 80;
      allow delete: if signedIn() && request.auth.uid == '7mQtL5NIu0RtN5UOWy8TLiWL5zP2';
    }

    match /players/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      // Akun baru langsung aktif. Status dan jabatan awal ditetapkan oleh aturan.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid','fullName','instagram','gender','grade','major','classNumber',
          'status','schoolStatus','position','followDeclaration','createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid','fullName','instagram','gender','grade','major','classNumber',
          'status','schoolStatus','position','followDeclaration','createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.fullName.size() <= 70
        && request.resource.data.instagram is string
        && request.resource.data.instagram.matches('^[A-Za-z0-9._]{2,30}$')
        && request.resource.data.gender in ['L','P']
        && request.resource.data.grade in ['X','XI','XII']
        && validMajor(request.resource.data.major)
        && validClass(request.resource.data.major,request.resource.data.classNumber)
        && request.resource.data.status == 'approved'
        && request.resource.data.schoolStatus == (request.resource.data.gender == 'L' ? 'Taruna' : 'Taruni')
        && request.resource.data.position == 'Anggota'
        && request.resource.data.followDeclaration == true
        && request.resource.data.createdAt == request.time;

      // Siswa hanya boleh mengubah pilihan avatar miliknya sendiri.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarId','fullName'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['avatarId']) || request.resource.data.avatarId in ['taruna','taruni','sporty','formal'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['fullName']) || (request.resource.data.fullName is string && request.resource.data.fullName.size() >= 3 && request.resource.data.fullName.size() <= 70));
      // Perubahan jabatan dan penghapusan akun melalui backend admin tepercaya.
      allow delete: if false;
    }

    match /attendance/{attendanceId} {
      // Izinkan pemeriksaan dokumen yang belum ada agar absensi pertama dapat dibuat.
      // Jika dokumen sudah ada, hanya pemiliknya yang boleh membacanya.
      allow get: if signedIn() && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid','fullName','major','grade','classNumber','date','status','createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.major is string
        && request.resource.data.grade in ['X','XI','XII']
        && request.resource.data.date is string
        && request.resource.data.status == 'hadir'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /classCounts/{id} {
      allow read, write: if false;
    }
  }
}